  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --test scripts/*.test.cjs",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,studio",
    "db:migrate": "supabase migration up --local",
    "db:env": "node scripts/supabase-local.mjs env",
    "db:types": "node scripts/supabase-local.mjs types",
    "db:verify": "node scripts/verify-supabase.mjs",
    "db:stop": "supabase stop",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest --no-discovery",
    "remotion:verify": "node scripts/verify-remotion-fallback.mjs",
    "remotion:bundle:smoke": "node scripts/verify-remotion-bundle.cjs",
    "remotion:trace:verify": "node scripts/verify-remotion-runtime-trace.cjs",
    "remotion:site:deploy": "remotion lambda sites create remotion/index.ts --site-name=my-motion"
  },
  "dependencies": {
