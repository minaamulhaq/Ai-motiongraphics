NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
# Keep false until Clerk Billing is enabled and at least one paid user plan exists.
NEXT_PUBLIC_CLERK_BILLING_ENABLED=false
# Clerk Billing webhook endpoint: /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=your-clerk-webhook-signing-secret
# Map each Clerk plan slug to generation credits granted per billing period.
CLERK_PLAN_CREDITS={"your-plan-slug":100}
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# Alternative provider when OPENROUTER_API_KEY is absent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
SUPABASE_SERVICE_ROLE_KEY=your-server-only-worker-key
# Remotion Lambda export. Deploy a Lambda function and create a Remotion Lambda S3 bucket first.

REMOTION_LAMBDA_BUCKET=remotionlambda-your-account-id-us-east-1
# Local development
# INNGEST_DEV=1
# Deployed environment: INNGEST_DEV=0 and set both Inngest keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
